# Copy to <Acervo root>/secrets.env with mode 600. deploy.sh creates this
# interactively on first use.
ACERVO_ANKI_SYNC_USERNAME=anki
ACERVO_ANKI_SYNC_PASSWORD=replace-with-a-long-unique-password
ACERVO_PB_SUPERUSER_EMAIL=admin@account.example.com
ACERVO_PB_SUPERUSER_PASSWORD=replace-with-a-long-unique-password
