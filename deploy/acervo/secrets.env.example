ACERVO_ANKI_SYNC_USERNAME=anki
ACERVO_ANKI_SYNC_PASSWORD=replace-with-a-long-unique-password
# Minted by install.sh on first deployment and kept: regenerating it signs out every device.
ACERVO_JWT_SECRET=replace-with-a-long-random-string
# The account batch jobs write through. The owner's own, not a service account: every record is
# owner-scoped, so a second account could not write against the owner's words at all.
ACERVO_OWNER_EMAIL=learner@account.example.com
ACERVO_OWNER_PASSWORD=the-password-you-gave---create-account

# Authorises channel management on the corpus service. Minted by install.sh on first deployment and
# kept, so a redeploy does not lock the running service out of its own catalogue. It never reaches a
# browser: Acervo's proxy attaches it server-side, like a provider key.
ACERVO_SPEECH_OPERATOR_TOKEN=
