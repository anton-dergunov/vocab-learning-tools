# Copy to <Acervo root>/llm.env with mode 600, or use deploy.sh --configure-llm.
ACERVO_LLM_PROVIDER=vertex
ACERVO_LLM_MODEL=gemini-3.7-flash
ACERVO_VERTEX_PROJECT=project-example
ACERVO_VERTEX_LOCATION=global
VERTEX_API_KEY=replace-with-a-vertex-restricted-key

# Retained when Vertex is selected, so the server can later switch back to the Developer API.
GEMINI_API_KEY=replace-with-a-gemini-developer-key
