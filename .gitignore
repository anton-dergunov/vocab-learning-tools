# Generated PWA staging area populated by `npm run stage:pwa` before deployment.
/deploy/acervo/pocketbase/pb_public/*
!/deploy/acervo/pocketbase/pb_public/.gitkeep
/DerivedData/
/macos/Acervo.xcodeproj/
/macos/Resources/Assets.xcassets/
.acervo-deploy
/deploy/acervo/llm.env
*.swp
*.swo

# Serving probe.html to a phone over https needs a local certificate and a Caddyfile in the
# experiment directory (see experiments/external-dictionaries/README.md). Neither belongs in a
# public repository — the Caddyfile carries a LAN address and the key is a private key.
Caddyfile
*.pem
*-key.pem

# Local working files that carry deployment specifics: `ingest.sh` holds the account password and
# the tailnet hostname of the live server, `TODO.txt` holds pasted terminal output with home paths.
# Both are untracked but were not ignored, which is one `git add -A` away from publishing them —
# and it is what `tests/unit/test_public_repository_privacy.py` was failing on.
# and `vertex-remote-config.txt` is a pasted agent report carrying a personal Google account, a GCP
# project and organization id, and home paths.
/ingest.sh
/TODO.txt
/vertex-remote-config.txt
